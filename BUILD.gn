import("//build/boards/${board}.gni")
import("//build/templates/dynamic_app.gni")
import("//build/templates/build_template.gni")
import("//build/toolchain/blueos.gni")

# C29 §18.2: the bootstrap shell as a C-style no_std dynamic PIE. It links
# `blueos_scrt1` as its start object and imports the shared libc through the
# `libc.so.1` DSO; everything it calls crosses the DSO boundary (printf,
# malloc/free, the POSIX file surface). The kernel's boot seed path embeds
# this artifact as /apps/shell/app.elf and launches it as the first
# application.
#
# The board `app_config` cannot be reused verbatim: it still carries
# `-z norelro`, which the dynamic-app contract forbids (C18). Spell the board
# ABI config (clang + LLD + target) here instead; the artifact link policy
# itself stays in the template.
dynamic_app("shell") {
  sources = [ "src/main.rs" ]
  start_object = "//librs:blueos_scrt1"
  deps = [
    "//external/vendor/phf-0.12.1:phf",
    "//libc",
    "//librs:blueos_scrt1",
    "//librs:libc",
  ]
  _lib_dir = rebase_path("${root_out_dir}/lib")
  rustflags = [
    "-Clinker=clang",
    "-Clink-arg=-fuse-ld=lld",
    "-Clink-arg=--target=${dynamic_link_target}",
    "-Clink-arg=-L${_lib_dir}",
    "-Clink-arg=-l:liblibrs.so",
    # scrt1 resolves `main` through its GOT slot; export the symbol so LLD
    # emits the R_ARM_GLOB_DAT that the kernel loader fills at load time.
    "-Clink-arg=-Wl,--export-dynamic-symbol=main",
  ]
  foreach(_option, dynamic_link_options) {
    rustflags += [ "-Clink-arg=${_option}" ]
  }
}

# The boot image for the board: the kernel with the embedded system image.
# Its sole static entry launches the shell PIE after the boot seed path has
# assembled the application service, so the runner boots `kernel_image`, not
# the shell ELF directly.
gen_qemu_runner("shell_runner") {
  img = "//kernel/kernel:kernel_image"
  qemu = "$qemu_exe"
  machine = "$qemu_machine"
  semihosting = true
  qemu_args = qemu_extra_args
  net_args = qemu_net_args
  block_img = "shell_block.img"
  block_args = qemu_block_args
}
